---
import Layout from "../layouts/Layout.astro";
import { LoginOtpForm } from "../components/LoginOtpForm";
import { SocialButtons } from "../components/SocialButtons";

const user = Astro.locals.user;
if (user) {
  return Astro.redirect("/dashboard");
}

const rawError = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  oauth_failed: "We couldn't sign you in with that provider. Please try again.",
  access_denied: "Sign-in was cancelled.",
};
const error = rawError ? errorMessages[rawError] ?? rawError : null;
const message = Astro.url.searchParams.get("message");
const email = Astro.url.searchParams.get("email") ?? undefined;
const returnUrl = Astro.url.searchParams.get("returnUrl") ?? undefined;
---

<Layout title="Sign In">
  <div class="flex min-h-[calc(100vh-3.5rem)] items-center justify-center px-4">
    <div class="w-full max-w-[400px]">
      <div class="mb-8 text-center">
        <a href="/" class="inline-block text-3xl font-bold text-text-primary">Quick Cuts</a>
        <p class="mt-2 text-sm text-text-secondary">
          Collaborative video review. Upload, share, get feedback.
        </p>
      </div>

      <div class="rounded-2xl border border-border-default bg-bg-secondary p-8">
        {message && (
          <div class="mb-4 rounded-lg bg-accent-warning/15 px-4 py-2 text-sm text-accent-warning">
            {message}
          </div>
        )}
        {error && (
          <div class="mb-4 rounded-lg bg-accent-danger/15 px-4 py-2 text-sm text-accent-danger">
            {error}
          </div>
        )}

        <p class="mb-6 text-center text-sm text-text-tertiary">
          Sign in with Google, or use a one-time code sent to your email.
        </p>

        <SocialButtons mode="login" returnUrl={returnUrl} client:load />

        <div class="my-6 flex items-center gap-3">
          <div class="h-px flex-1 bg-border-default"></div>
          <span class="text-xs uppercase tracking-wide text-text-tertiary">or</span>
          <div class="h-px flex-1 bg-border-default"></div>
        </div>

        <LoginOtpForm mode="login" email={email} returnUrl={returnUrl} client:load />

      </div>
    </div>
  </div>
</Layout>
